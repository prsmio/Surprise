+    /** Draws the amount area for Surprises. Returns false to let the normal amount draw. */
+    private boolean drawSurpriseAmount(Canvas canvas) {
+        final float amountTop = cardRect.top + dp(55);
+        if (surpriseSealed && surpriseRevealStart == 0) {
+            drawSurpriseDust(canvas, amountTop);
+            parentView.invalidate(); // the dust is alive
+            return true;
+        }
+        if (surpriseRevealStart == 0) return false;
+
+        final long t = SystemClock.elapsedRealtime() - surpriseRevealStart;
+        updateSurpriseAddress(t);
+        if (t >= SURPRISE_DECODE_END) {
+            surpriseDecodeText = null;
+            surpriseDecodeKey = null;
+            return false;
+        }
+        if (t < 700) {
+            drawSurpriseDust(canvas, amountTop); // scatters away with the spoiler ripple
+        }
+        if (surpriseAmountTarget != null && t >= 60) {
+            final float p = Math.max(0f, Math.min(1f, (t - SURPRISE_DECODE_START) / (float) (SURPRISE_DECODE_END - SURPRISE_DECODE_START)));
+            final SpannableStringBuilder sb = new SpannableStringBuilder(surpriseAmountTarget);
+            int digits = 0;
+            for (int i = 0; i < sb.length(); i++) if (Character.isDigit(sb.charAt(i))) digits++;
+            final int locked = (int) Math.floor(p * digits + 0.0001f);
+            final long tick = t / 45;
+            int d = 0;
+            for (int i = 0; i < sb.length(); i++) {
+                if (!Character.isDigit(sb.charAt(i))) continue;
+                if (d >= locked) {
+                    surpriseRandom.setSeed(tick * 7919L + i * 31L);
+                    sb.replace(i, i + 1, String.valueOf((char) ('0' + surpriseRandom.nextInt(10))));
+                }
+                d++;
+            }
+            final String key = sb.toString();
+            if (surpriseDecodeText == null || !key.equals(surpriseDecodeKey)) {
+                surpriseDecodeText = new Text(sb, 16, AndroidUtilities.bold());
+                surpriseDecodeKey = key;
+            }
+            final float width = surpriseDecodeText.getWidth();
+            final float maxWidth = cardRect.width() - dp(16);
+            final float scale = width > maxWidth ? maxWidth / width : 1.0f;
+            final float centerY = amountTop + surpriseDecodeText.getHeight() / 2.0f;
+            final float alpha = Math.min(1f, (t - 60) / 240f);
+            canvas.save();
+            canvas.scale(scale, scale, cardRect.centerX(), centerY);
+            surpriseDecodeText.draw(canvas, cardRect.centerX() - width / 2.0f, centerY, 0xFFFFFFFF, alpha);
+            canvas.restore();
+        }
+        parentView.invalidate();
+        return true;
+    }
+
+    private void drawSurpriseDust(Canvas canvas, float amountTop) {
+        if (surpriseSpoilerText == null) return;
+        canvas.save();
+        canvas.translate(cardRect.centerX() - surpriseSpoilerText.getWidth() / 2.0f, amountTop);
+        for (SpoilerEffect spoiler : surpriseSpoilers) {
+            spoiler.setColor(0xFFFFFFFF);
+            spoiler.draw(canvas);
+        }
+        canvas.restore();
+    }
+
+    /** The wallet address re-hashes for a moment while the amount decodes. */
+    private void updateSurpriseAddress(long t) {
+        if (addressText == null || surpriseAddress == null) return;
+        if (t < SURPRISE_ADDRESS_END) {
+            final StringBuilder sb = new StringBuilder(surpriseAddress);
+            final long tick = t / 45;
+            final String chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+            for (int i = 0; i < sb.length(); i++) {
+                if (Character.isLetterOrDigit(sb.charAt(i))) {
+                    surpriseRandom.setSeed(tick * 104729L + i * 17L);
+                    if (surpriseRandom.nextFloat() < 0.55f) {
+                        sb.setCharAt(i, chars.charAt(surpriseRandom.nextInt(chars.length())));
+                    }
+                }
+            }
+            addressText.setText(sb.toString());
+            surpriseAddressScrambled = true;
+        } else if (surpriseAddressScrambled) {
+            addressText.setText(surpriseAddress);
+            surpriseAddressScrambled = false;
+        }
+    }
+
+    /** Tap on a sealed card. */
+    private void startSurpriseReveal() {
+        if (!surpriseSealed || surpriseRevealStart != 0) return;
+        surpriseSealed = false;
+        surpriseRevealStart = SystemClock.elapsedRealtime();
+        try {
+            parentView.performHapticFeedback(android.view.HapticFeedbackConstants.KEYBOARD_TAP, android.view.HapticFeedbackConstants.FLAG_IGNORE_GLOBAL_SETTING);
+        } catch (Exception ignore) {}
+
+        // The card's own "received" choreography, with extra momentum.
+        animateSentBounce();
+        getDiamondRestingYaw();
+        sentSpinMomentum = 30f;
+        sentParticles.sent(0f, 0f);
+
+        // The dust scatters outwards like any Telegram spoiler.
+        if (surpriseSpoilerText != null) {
+            final float cx = surpriseSpoilerText.getWidth() / 2.0f, cy = surpriseSpoilerText.getHeight() / 2.0f;
+            for (SpoilerEffect spoiler : surpriseSpoilers) {
+                spoiler.startRipple(cx, cy, surpriseSpoilerText.getWidth());
+            }
+        }
+
+        // Ribbon: "Surprise" -> "Received", violet -> blue.
+        parentView.postDelayed(() -> {
+            ribbonColorFrom = ribbonColorCurrent;
+            ribbonColorTo = 0xFF4BB9FE;
+            ribbonColorAnimation.force(0);
+            ribbon.setTextAnimated(10, LocaleController.getString(R.string.WalletTransferStatusReceived), true);
+            parentView.invalidate();
+        }, 650);
+
+        // The note appears once the number has settled.
+        parentView.postDelayed(() -> {
+            surpriseCommentHidden = false;
+            if (commentText != null && action != null && !TextUtils.isEmpty(action.comment) && !action.comment_encrypted) {
+                commentSpoilersPool.addAll(commentSpoilers);
+                commentSpoilers.clear();
+                commentText.setText(Emoji.replaceEmoji(action.comment, commentText.paint.getFontMetricsInt(), false));
+                parentView.requestLayout();
+            }
+            parentView.invalidate();
+        }, 900);
+
+        // Done: highlight sweep, confetti, and let the sender know.
+        parentView.postDelayed(() -> {
+            try {
+                parentView.performHapticFeedback(android.view.HapticFeedbackConstants.LONG_PRESS, android.view.HapticFeedbackConstants.FLAG_IGNORE_GLOBAL_SETTING);
+            } catch (Exception ignore) {}
+            animateHighlight();
+            if (surpriseOnOpened != null) {
+                surpriseOnOpened.run();
+                surpriseOnOpened = null;
+            }
+            parentView.invalidate();
+        }, SURPRISE_DECODE_END);
+
+        parentView.invalidate();
+    }
