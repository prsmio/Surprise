+++ b/TMessagesProj/src/main/java/org/telegram/ui/Wallet/SurpriseDemo.java
@@ -0,0 +1,334 @@
+package org.telegram.ui.Wallet;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.graphics.drawable.GradientDrawable;
+import android.text.TextUtils;
+import android.util.Base64;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.HapticFeedbackConstants;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.Emoji;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.SendMessagesHelper;
+import org.telegram.messenger.UserConfig;
+import org.telegram.messenger.Utilities;
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.tgnet.TLObject;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.tgnet.tl.TL_wallet;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.ChatActivity;
+import org.telegram.ui.Components.LayoutHelper;
+import org.telegram.ui.Components.Reactions.ReactionsLayoutInBubble;
+import org.telegram.ui.Components.ScaleStateListAnimator;
+import org.telegram.ui.LaunchActivity;
+
+import java.nio.charset.StandardCharsets;
+import java.security.SecureRandom;
+import java.util.ArrayList;
+
+import static org.telegram.messenger.AndroidUtilities.dp;
+
+/**
+ * Surprise — sealed Gram transfers, built on top of Telegram's real Wallet.
+ *
+ * DEMO MODE (this file only): the wallet shows a 2,000 GRAM balance and "Send" does not
+ * touch the blockchain. Instead it delivers a carrier message whose visible text is only
+ * "🎁 Surprise"; the amount, addresses and note travel inside an invisible link. On both
+ * phones the carrier is turned, in memory, into a real Gram-transfer service message, so it
+ * is drawn by Telegram's own wallet card (WalletActionLayout) and the real send flight.
+ *
+ * For production, only this transport layer goes away: a real transfer would carry a
+ * "surprise" flag, and everything in WalletActionLayout stays exactly as it is.
+ */
+public class SurpriseDemo {
+
+    /** Turn the demo off to go back to real transfers. */
+    public static boolean ENABLED = true;
+    public static final long DEMO_BALANCE_NANOS = 2_000L * 1_000_000_000L;
+
+    /** Set by the "Send as Surprise" chip in the Money tab, read by send(). */
+    public static boolean pendingSurprise;
+
+    public static final String TX_DEMO = "demo-";
+    public static final String TX_SURPRISE = "surprise-";
+    public static final String OPENED_REACTION = "\uD83C\uDF89";
+
+    private static final String TEXT_SURPRISE = "\uD83C\uDF81 Surprise";
+    private static final String TEXT_PLAIN = "\uD83D\uDC8E Grams";
+    private static final String URL_PREFIX = "https://telegram.org/gram#v2.";
+    private static final String FALLBACK_ADDRESS = "UQBDEMOWALLETADDRESSFORTHESURPRISEPROTOTYPEXYZ1";
+    private static final int B64 = Base64.URL_SAFE | Base64.NO_WRAP | Base64.NO_PADDING;
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("surprise_demo", Context.MODE_PRIVATE);
+    }
+
+    // ------------------------------------------------------------------ balance
+
+    public static long getBalance(int account) {
+        return Math.max(0, DEMO_BALANCE_NANOS - prefs().getLong("spent_" + account, 0));
+    }
+
+    private static void spend(int account, long amount) {
+        prefs().edit().putLong("spent_" + account, prefs().getLong("spent_" + account, 0) + amount).apply();
+    }
+
+    // ------------------------------------------------------------------ sending
+
+    /** Replaces GramWallet.send() while the demo is on. */
+    public static void send(int account, TLRPC.User user, String toAddress, long amount, String comment,
+                            Utilities.Callback<String> whenSent, Utilities.Callback<TL_wallet.walletTransaction> whenQueued) {
+        final boolean surprise = pendingSurprise;
+        final String txId = (surprise ? TX_SURPRISE : TX_DEMO) + Long.toHexString(new SecureRandom().nextLong() & Long.MAX_VALUE);
+        String fromAddress = null;
+        try {
+            fromAddress = GramWallet.getInstance(account).getAddress();
+        } catch (Exception e) {
+            FileLog.e(e);
+        }
+        final String text = surprise ? TEXT_SURPRISE : TEXT_PLAIN;
+        final TLRPC.TL_messageEntityTextUrl link = new TLRPC.TL_messageEntityTextUrl();
+        link.offset = 0;
+        link.length = text.length();
+        link.url = URL_PREFIX + amount + "." + b64(toAddress) + "." + b64(fromAddress) + "." + b64(comment) + "." + txId;
+        final ArrayList<TLRPC.MessageEntity> entities = new ArrayList<>();
+        entities.add(link);
+
+        // sendMessage() takes the next local id; remember it so the real flight can find the card.
+        final int localId = UserConfig.getInstance(account).lastSendMessageId;
+        SendMessagesHelper.getInstance(account).sendMessage(SendMessagesHelper.SendMessageParams.of(
+                text, user.id, null, null, null, false, entities, null, null, true, 0, 0, null, false));
+        spend(account, amount);
+
+        final TL_wallet.walletTransaction transaction = new TL_wallet.walletTransaction();
+        transaction.id = txId;
+        transaction.localMessageId = localId;
+        transaction.amount = amount;
+        transaction.comment = comment;
+        transaction.date = ConnectionsManager.getInstance(account).getCurrentTime();
+        if (whenQueued != null) {
+            whenQueued.run(transaction);
+        }
+        AndroidUtilities.runOnUIThread(() -> {
+            if (whenSent != null) {
+                whenSent.run(null);
+            }
+        }, 300);
+    }
+
+    // ------------------------------------------------------------------ carrier -> real transfer
+
+    /** Turns a carrier message into a real Gram-transfer service message (in memory only). */
+    public static TLRPC.Message convert(TLRPC.Message m) {
+        if (!ENABLED || m == null || m instanceof TLRPC.TL_messageService || m.entities == null || m.entities.isEmpty()) {
+            return m;
+        }
+        String url = null;
+        for (int i = 0; i < m.entities.size(); i++) {
+            final TLRPC.MessageEntity e = m.entities.get(i);
+            if (e instanceof TLRPC.TL_messageEntityTextUrl && e.url != null && e.url.startsWith(URL_PREFIX)) {
+                url = e.url;
+                break;
+            }
+        }
+        if (url == null) {
+            return m;
+        }
+        try {
+            final String[] p = url.substring(URL_PREFIX.length()).split("\\.", -1);
+            final long amount = Long.parseLong(p[0]);
+            final String to = unb64(p[1]);
+            final String from = unb64(p[2]);
+            final String comment = unb64(p[3]);
+            final String txId = p[4];
+
+            final TLRPC.TL_messageService s = new TLRPC.TL_messageService();
+            s.id = m.id;
+            s.local_id = m.local_id;
+            s.random_id = m.random_id;
+            s.dialog_id = m.dialog_id;
+            s.from_id = m.from_id;
+            s.peer_id = m.peer_id;
+            s.date = m.date;
+            s.out = m.out;
+            s.unread = m.unread;
+            s.media_unread = m.media_unread;
+            s.silent = m.silent;
+            s.send_state = m.send_state;
+            s.reactions = m.reactions;
+            s.attachPath = m.attachPath;
+            s.params = m.params;
+            s.ttl = m.ttl;
+            s.premiumEffectWasPlayed = m.premiumEffectWasPlayed;
+            s.message = "";
+            s.flags = (s.from_id != null ? 256 : 0) | (s.reactions != null ? (1 << 20) : 0);
+
+            final TLRPC.TL_messageActionGramTransfer action = new TLRPC.TL_messageActionGramTransfer();
+            action.amount = amount;
+            final String address = m.out ? to : from;
+            action.peer_address = TextUtils.isEmpty(address) ? FALLBACK_ADDRESS : address;
+            action.transaction_id = txId;
+            action.comment = TextUtils.isEmpty(comment) ? null : comment;
+            s.action = action;
+            return s;
+        } catch (Exception e) {
+            FileLog.e(e);
+            return m;
+        }
+    }
+
+    // ------------------------------------------------------------------ state
+
+    private static TLRPC.TL_messageActionGramTransfer action(MessageObject mo) {
+        if (mo == null || mo.messageOwner == null || !(mo.messageOwner.action instanceof TLRPC.TL_messageActionGramTransfer)) {
+            return null;
+        }
+        return (TLRPC.TL_messageActionGramTransfer) mo.messageOwner.action;
+    }
+
+    private static boolean isDemo(TLRPC.TL_messageActionGramTransfer a) {
+        return a != null && a.transaction_id != null && (a.transaction_id.startsWith(TX_DEMO) || a.transaction_id.startsWith(TX_SURPRISE));
+    }
+
+    private static boolean isSurprise(TLRPC.TL_messageActionGramTransfer a) {
+        return a != null && a.transaction_id != null && a.transaction_id.startsWith(TX_SURPRISE);
+    }
+
+    private static String openedKey(int account, TLRPC.TL_messageActionGramTransfer a) {
+        return "opened_" + account + "_" + a.transaction_id;
+    }
+
+    /** Incoming Surprise that has not been opened yet. */
+    public static boolean isSealed(MessageObject mo) {
+        final TLRPC.TL_messageActionGramTransfer a = action(mo);
+        return isSurprise(a) && !mo.isOutOwner() && !prefs().getBoolean(openedKey(mo.currentAccount, a), false);
+    }
+
+    private static boolean peerReacted(MessageObject mo) {
+        final TLRPC.TL_messageReactions r = mo.messageOwner.reactions;
+        if (r == null || r.results == null) {
+            return false;
+        }
+        for (int i = 0; i < r.results.size(); i++) {
+            final TLRPC.ReactionCount rc = r.results.get(i);
+            if (rc.count - (rc.chosen ? 1 : 0) > 0) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** Chat list / service text while sealed: no amount. */
+    public static CharSequence sealedText(TLObject from) {
+        return MessageObject.replaceWithLink(AndroidUtilities.replaceTags("**un1** sent you a \uD83C\uDF81 Surprise"), "un1", from);
+    }
+
+    public static String sealedNotification(String name) {
+        return name + " sent you a \uD83C\uDF81 Surprise";
+    }
+
+    /** Called by ChatActionCell right before the real card is bound to a message. */
+    public static void bind(WalletActionLayout layout, MessageObject mo) {
+        final TLRPC.TL_messageActionGramTransfer a = action(mo);
+        if (!isDemo(a)) {
+            layout.setSurprise(false, false, false, false, null, null);
+            return;
+        }
+        final boolean surprise = isSurprise(a);
+        final boolean out = mo.isOutOwner();
+        final boolean sealed = surprise && !out && !prefs().getBoolean(openedKey(mo.currentAccount, a), false);
+        final boolean peerOpened = surprise && out && peerReacted(mo);
+        if (!out) {
+            // Our reveal replaces the automatic "received" animation.
+            mo.messageOwner.premiumEffectWasPlayed = true;
+        }
+        layout.setSurprise(true, surprise, sealed, peerOpened, a.transaction_id, sealed ? () -> markOpened(mo) : null);
+    }
+
+    private static void markOpened(MessageObject mo) {
+        final TLRPC.TL_messageActionGramTransfer a = action(mo);
+        if (a == null) {
+            return;
+        }
+        prefs().edit().putBoolean(openedKey(mo.currentAccount, a), true).apply();
+        final BaseFragment fragment = LaunchActivity.getLastFragment();
+        if (fragment instanceof ChatActivity) {
+            ((ChatActivity) fragment).startFireworks();
+        }
+        try {
+            final ReactionsLayoutInBubble.VisibleReaction reaction = ReactionsLayoutInBubble.VisibleReaction.fromEmojicon(OPENED_REACTION);
+            final ArrayList<ReactionsLayoutInBubble.VisibleReaction> list = new ArrayList<>();
+            list.add(reaction);
+            if (fragment != null) {
+                SendMessagesHelper.getInstance(mo.currentAccount).sendReaction(mo, list, reaction, false, false, fragment, null);
+            }
+        } catch (Exception e) {
+            FileLog.e(e);
+        }
+    }
+
+    // ------------------------------------------------------------------ the toggle in the Money tab
+
+    public static void addSurpriseToggle(Context context, LinearLayout parent, Theme.ResourcesProvider resourcesProvider) {
+        if (!ENABLED) {
+            return;
+        }
+        pendingSurprise = false;
+        final TextView chip = new TextView(context);
+        chip.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14);
+        chip.setTypeface(AndroidUtilities.bold());
+        chip.setGravity(Gravity.CENTER);
+        chip.setPadding(dp(15), dp(7), dp(15), dp(8));
+        final Runnable update = () -> {
+            final GradientDrawable bg = new GradientDrawable();
+            bg.setCornerRadius(dp(18));
+            if (pendingSurprise) {
+                bg.setOrientation(GradientDrawable.Orientation.LEFT_RIGHT);
+                bg.setColors(new int[]{0xFF8E63FF, 0xFF4BB9FE});
+                chip.setTextColor(0xFFFFFFFF);
+            } else {
+                bg.setColor(0x00000000);
+                bg.setStroke(Math.max(1, dp(1)), Theme.getColor(Theme.key_wallet_out_commentBorder, resourcesProvider));
+                chip.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2, resourcesProvider));
+            }
+            chip.setBackground(bg);
+            final String label = pendingSurprise ? "\uD83C\uDF81 Surprise is on" : "\uD83C\uDF81 Send as Surprise";
+            chip.setText(Emoji.replaceEmoji(label, chip.getPaint().getFontMetricsInt(), false));
+        };
+        update.run();
+        chip.setOnClickListener(v -> {
+            pendingSurprise = !pendingSurprise;
+            v.performHapticFeedback(HapticFeedbackConstants.KEYBOARD_TAP);
+            update.run();
+        });
+        ScaleStateListAnimator.apply(chip, .02f, 1.2f);
+        parent.addView(chip, LayoutHelper.createLinear(
+                LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT,
+                Gravity.TOP | Gravity.CENTER_HORIZONTAL, 32, 10, 32, 0));
+    }
+
+    // ------------------------------------------------------------------ helpers
+
+    private static String b64(String s) {
+        if (TextUtils.isEmpty(s)) {
+            return "";
+        }
+        return Base64.encodeToString(s.getBytes(StandardCharsets.UTF_8), B64);
+    }
+
+    private static String unb64(String s) {
+        if (TextUtils.isEmpty(s)) {
+            return "";
+        }
+        return new String(Base64.decode(s, B64), StandardCharsets.UTF_8);
+    }
+}
