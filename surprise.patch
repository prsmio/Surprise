+    /** Called from set() once the amount text is known. */
+    private void prepareSurprise(CharSequence localizedAmount) {
+        surpriseAmountTarget = localizedAmount;
+        surpriseSpoilersPool.addAll(surpriseSpoilers);
+        surpriseSpoilers.clear();
+        surpriseSpoilerText = null;
+        if (!surpriseSealed) return;
+        // Fixed length, so the dust never hints at how big the number is.
+        final SpannableStringBuilder placeholder = new SpannableStringBuilder("a".repeat(8));
+        final TextStyleSpan.TextStyleRun run = new TextStyleSpan.TextStyleRun();
+        run.flags |= TextStyleSpan.FLAG_STYLE_SPOILER;
+        placeholder.setSpan(new TextStyleSpan(run), 0, placeholder.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+        surpriseSpoilerText = new Text(placeholder, 16, AndroidUtilities.bold());
+        SpoilerEffect.addSpoilers(parentView, surpriseSpoilerText.getLayout(), surpriseSpoilersPool, surpriseSpoilers);
+    }
