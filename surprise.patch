+    private String surpriseRibbonText(String fallback, boolean failed) {
+        if (!surprise || failed) return fallback;
+        if (out) return surprisePeerOpened ? "Opened" : "Surprise";
+        return surpriseSealed ? "Surprise" : fallback;
+    }
+
+    private int surpriseRibbonColor(int fallback) {
