@@ -125,6 +125,237 @@ public class WalletActionLayout {
     private TLRPC.TL_messageActionGramTransfer action;
     private boolean preparingCommentRevealed;
     private Text amountText;
+
+    // ------------------------------------------------------------------ Surprise (sealed transfers)
+    // The amount stays hidden under spoiler dust until the recipient taps the card. The reveal reuses
+    // this card's own choreography: momentum spin, bounce, sent particles, ribbon and highlight.
+
+    private static final int SURPRISE_COLOR = 0xFF9466FF;
+    private static final long SURPRISE_DECODE_START = 120;
+    private static final long SURPRISE_DECODE_END = 1150;
+    private static final long SURPRISE_ADDRESS_END = 700;
+
+    private boolean surpriseDemo, surprise, surpriseSealed, surpriseCommentHidden, surprisePeerOpened;
+    private String surpriseBoundTx;
+    private Runnable surpriseOnOpened;
+    private Text surpriseSpoilerText;
+    private final ArrayList<SpoilerEffect> surpriseSpoilers = new ArrayList<>();
+    private final Stack<SpoilerEffect> surpriseSpoilersPool = new Stack<>();
+    private long surpriseRevealStart;
+    private CharSequence surpriseAmountTarget;
+    private Text surpriseDecodeText;
+    private String surpriseDecodeKey;
+    private String surpriseAddress;
+    private boolean surpriseAddressScrambled;
+    private final java.util.Random surpriseRandom = new java.util.Random();
+
+    /** Called right before set(). */
+    public void setSurprise(boolean demo, boolean surprise, boolean sealed, boolean peerOpened, String txId, Runnable onOpened) {
+        final boolean sameTx = txId != null && txId.equals(surpriseBoundTx);
+        final boolean justOpenedByPeer = surprise && sameTx && peerOpened && !surprisePeerOpened;
+        this.surpriseDemo = demo;
+        this.surprise = surprise;
+        if (!sameTx) {
+            surpriseRevealStart = 0;
+            surpriseAddressScrambled = false;
+        }
+        if (surpriseRevealStart == 0) {
+            this.surpriseSealed = surprise && sealed;
+            this.surpriseCommentHidden = this.surpriseSealed;
+        }
+        this.surprisePeerOpened = peerOpened;
+        this.surpriseOnOpened = onOpened;
+        this.surpriseBoundTx = txId;
+        if (justOpenedByPeer) {
+            // Sender side: the other person just opened it.
+            parentView.post(() -> {
+                animateSentBounce();
